# Settings for spinpid2.sh (Supermicro boards with two fan zones).
# Sourced by the script from its own directory; keep it beside spinpid2.sh and spincommon.sh.
# shellcheck disable=SC2034

#################  TOOLS  ################

# Add " -H <host> -U <user> -P <password>" inside the quotes to drive a remote BMC (e.g. from a VM).
IPMITOOL="/usr/local/bin/ipmitool"
SMARTCTL="/usr/local/sbin/smartctl"
CAMCONTROL="/sbin/camcontrol"

#################  OUTPUT  ################

LOG=/var/log/spinpid2.log
# 1: log file and console (good for testing); 0: log file only.
LOG_CONSOLE=1

# 1: also write a line per CPU cycle to CPU_LOG. It grows fast; turn it off after tuning.
CPU_LOG_YES=0
CPU_LOG=$DIR/cpu.log

#################  DRIVES  ################

# camcontrol devlist lines matching these sed patterns are not drives to control (SSDs, enclosures, cards).
DEVLIST_EXCLUDE='/KINGSTON/d;/ADATA/d;/SanDisk/d;/OCZ/d;/LSI/d;/EXP/d;/INTEL/d;/TDKMedia/d;/SSD/d;/VMware/d;/Enclosure/d;/Card/d;/Flash/d'

# Setpoint: mean drive temperature (C).
SP=43

# Whole minutes between drive checks. Drives change temperature slowly; 5 is usually enough.
DRIVE_T=5

# Proportional and derivative constants for the drive PID; see "Tuning" in README.md.
Kp=4
Kd=40

#################  FANS  ################

# Supermicro: zone 0 = numbered headers (FAN1..FAN5), zone 1 = lettered headers (FANA, FANB).
# Default: CPU fans on the lettered headers (zone 1), drive fans on the numbered headers (zone 0).
# The RPM reference fans are FANA for zone 1 and FAN1 for zone 0, so both headers must be populated.
ZONE_CPU=1
ZONE_PER=0

# Duty cycle (%) limits. Set the minimum above the stall point of the slowest fan
# (see "My Fans are revving up and down?" in README.md).
DUTY_PER_MIN=25
DUTY_PER_MAX=100
DUTY_CPU_MIN=20
DUTY_CPU_MAX=100

# RPM of the reference fans at 30 % and 100 % duty, measured with spintest.sh.
RPM_CPU_30=900
RPM_CPU_MAX=2500
RPM_PER_30=400
RPM_PER_MAX=1200

# 1: read the current duty from the board each cycle.
# 0: assume the duty is what the script last set (for boards that report the duty incorrectly).
HOW_DUTY=1

#################  CPU  ################

# Whole seconds between CPU checks; 1 to 12 may be appropriate.
CPU_T=5

# At and below CPU_REF (C) the CPU zone runs at DUTY_CPU_MIN; each degree above adds CPU_SCALE
# duty points. Integers only.
CPU_REF=50
CPU_SCALE=5

# IPMI sensor used when coretemp (dev.cpu.N.temperature) is unavailable, e.g. in a VM.
# Dual-socket boards name their sensors "CPU1 Temp" and "CPU2 Temp".
CPU_TEMP_SENSOR="CPU Temp"

#################  HOOKS  ################

# Optional functions Post_DRIVES_check_adjust and Post_CPU_check_adjust run after each drive
# and CPU check (for example to feed Grafana). They may read Tmean, Tmax, ERRc, P, D, PD,
# DUTY_PER, DUTY_CPU, CPU_TEMP, the fan RPMs FAN1..FAN5, FANA, FANB and SDR (the last
# `ipmitool sdr` output); see the calls in spinpid2.sh.
